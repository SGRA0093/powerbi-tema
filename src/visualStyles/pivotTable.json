{
  "*": {
    "padding": [
      {
        "top": 15,
        "bottom": 15,
        "left": 20,
        "right": 20
      }
    ],
    "border": [
      {
        "color": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "show": true,
        "radius": 5
      }
    ],
    "background": [
      {
        "show": true,
        "color": {
          "solid": {
            "color": "#FFFFFF"
          }
        },
        "transparency": 0
      }
    ],
    "dropShadow": [
      {
        "show": true,
        "color": {
          "solid": {
            "color": "#e3e2e1"
          }
        },
        "position": "Inner",
        "preset": "Custom",
        "shadowSpread": 1,
        "shadowBlur": 0,
        "angle": 0,
        "shadowDistance": 0,
        "transparency": 0
      }
    ],
    "stylePreset": [
      {
        "name": "AlternatingRows"
      }
    ],
    "grid": [
      {
        "gridVertical": true,
        "gridVerticalColor": {
          "solid": {
            "color": "#999999"
          }
        },
        "gridVerticalWeight": 1,
        "gridHorizontal": true,
        "gridHorizontalColor": {
          "solid": {
            "color": "#999999"
          }
        },
        "gridHorizontalWeight": 1,
        "rowPadding": 1,
        "outlineColor": {
          "solid": {
            "color": "#666666"
          }
        },
        "outlineWeight": 1,
        "outlineStyle": 0,
        "textSize": 12,
        "imageHeight": 75
      }
    ],
    "columnHeaders": [
      {
        "titleAlignment": "Auto",
        "urlIcon": false,
        "fontColor": {
          "solid": {
            "color": "#ffffff"
          }
        },
        "backColor": {
          "solid": {
            "color": {
              "expr": {
                "ThemeDataColor": {
                  "ColorId": 2,
                  "Percent": 0
                }
              }
            }
          }
        },
        "outlineColor": {
          "solid": {
            "color": "#666666"
          }
        },
        "outlineWeight": 1,
        "outlineStyle": 0,
        "autoSizeColumnWidth": true,
        "columnAdjustment": "growToFit",
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "fontSize": 12,
        "alignment": "Left",
        "wordWrap": true
      }
    ],
    "rowHeaders": [
      {
        "fontColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "outlineColor": {
          "solid": {
            "color": "#999999"
          }
        },
        "outlineWeight": 1,
        "outlineStyle": 75,
        "stepped": true,
        "steppedLayoutIndentation": 10,
        "urlIcon": false,
        "wordWrap": true,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "fontSize": 12,
        "alignment": "Left",
        "showExpandCollapseButtons": true,
        "expandCollapseButtonsColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "expandCollapseButtonsSize": 12
      }
    ],
    "values": [
      {
        "bandedRowHeaders": true,
        "valuesOnRow": false,
        "fontColorPrimary": {
          "solid": {
            "color": "#191815"
          }
        },
        "backColorPrimary": {
          "solid": {
            "color": "#FFFFFF"
          }
        },
        "fontColorSecondary": {
          "solid": {
            "color": "#191815"
          }
        },
        "backColorSecondary": {
          "solid": {
            "color": "#e3e2e1"
          }
        },
        "outlineColor": {
          "solid": {
            "color": "#999999"
          }
        },
        "outlineWeight": 1,
        "outlineStyle": 3,
        "urlIcon": false,
        "wordWrap": true,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "fontSize": 12
      }
    ],
    "subTotals": [
      {
        "$id": "Row",
        "fontColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": true,
        "italic": false,
        "underline": false,
        "applyToHeaders": true
      },
      {
        "$id": "Column",
        "fontColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": true,
        "italic": false,
        "underline": false,
        "applyToHeaders": false
      },
      {
        "rowSubtotals": true,
        "columnSubtotals": true,
        "perRowLevel": false,
        "perColumnLevel": false,
        "rowSubtotalsPosition": "Top"
      }
    ],
    "rowTotal": [
      {
        "applyToHeaders": true,
        "fontColor": {
          "solid": {
            "color": "#ffffff"
          }
        },
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "backColor": {
          "solid": {
            "color": {
              "expr": {
                "ThemeDataColor": {
                  "ColorId": 2,
                  "Percent": 0
                }
              }
            }
          }
        },
        "fontSize": 12
      }
    ],
    "columnTotal": [
      {
        "applyToHeaders": true,
        "fontColor": {
          "solid": {
            "color": "#ffffff"
          }
        },
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "backColor": {
          "solid": {
            "color": {
              "expr": {
                "ThemeDataColor": {
                  "ColorId": 2,
                  "Percent": 0
                }
              }
            }
          }
        },
        "fontSize": 12
      }
    ],
    "title": [
      {
        "show": true,
        "heading": "Normal",
        "titleWrap": true,
        "fontColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "background": {
          "solid": {
            "color": "#ffffff00"
          }
        },
        "alignment": "left",
        "fontSize": 14,
        "fontFamily": "Segoe UI",
        "bold": true,
        "italic": false,
        "underline": false
      }
    ],
    "subTitle": [
      {
        "show": false,
        "heading": "Normal",
        "fontFamily": "Segoe UI",
        "fontSize": 10,
        "bold": false,
        "italic": false,
        "underline": false,
        "fontColor": {
          "solid": {
            "color": "#605e5c"
          }
        },
        "alignment": "left",
        "titleWrap": true
      }
    ],
    "divider": [
      {
        "show": false,
        "color": {
          "solid": {
            "color": "#605E5C"
          }
        },
        "style": "solid",
        "width": 1,
        "ignorePadding": true
      }
    ],
    "spacing": [
      {
        "customizeSpacing": false,
        "verticalSpacing": 5,
        "spaceBelowTitle": 5,
        "spaceBelowSubTitle": 5,
        "spaceBelowTitleArea": 5
      }
    ],
    "lockAspect": [
      {
        "show": false
      }
    ],
    "visualTooltip": [
      {
        "show": true,
        "type": "Default",
        "titleFontColor": {
          "solid": {
            "color": "#ffffff"
          }
        },
        "valueFontColor": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "actionFontColor": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "background": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 5,
        "page": "Auto"
      }
    ],
    "visualHeader": [
      {
        "show": true,
        "background": {
          "solid": {
            "color": "#FFFFFF"
          }
        },
        "border": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 0,
        "foreground": {
          "solid": {
            "color": "#191815"
          }
        },
        "showVisualInformationButton": false,
        "showVisualWarningButton": false,
        "showVisualErrorButton": false,
        "showDrillRoleSelector": false,
        "showDrillUpButton": true,
        "showDrillToggleButton": true,
        "showDrillDownLevelButton": false,
        "showDrillDownExpandButton": true,
        "showPinButton": false,
        "showFocusModeButton": true,
        "showFilterRestatementButton": false,
        "showSeeDataLayoutToggleButton": false,
        "showOptionsMenu": false,
        "showTooltipButton": false,
        "showCommentButton": false,
        "showPersonalizeVisualButton": false,
        "showSmartNarrativeButton": false
      }
    ],
    "visualHeaderTooltip": [
      {
        "titleFontColor": {
          "solid": {
            "color": "#C8C8C8"
          }
        },
        "fontSize": 9,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "background": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 5
      }
    ]
  }
}
