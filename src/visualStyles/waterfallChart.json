{
  "*": {
    "padding": [
      {
        "top": 15,
        "bottom": 15,
        "left": 20,
        "right": 20
      }
    ],
    "border": [
      {
        "color": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "show": true,
        "radius": 5
      }
    ],
    "background": [
      {
        "show": true,
        "color": {
          "solid": {
            "color": "#FFFFFF"
          }
        },
        "transparency": 0
      }
    ],
    "dropShadow": [
      {
        "show": true,
        "color": {
          "solid": {
            "color": "#e3e2e1"
          }
        },
        "position": "Inner",
        "preset": "Custom",
        "shadowSpread": 1,
        "shadowBlur": 0,
        "angle": 0,
        "shadowDistance": 0,
        "transparency": 0
      }
    ],
    "general": [
      {
        "responsive": false,
        "keepLayerOrder": false,
        "outlineColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "outlineWeight": 2,
        "orientation": 0
      }
    ],
    "legend": [
      {
        "show": true,
        "position": "Top",
        "showTitle": false,
        "labelColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "fontFamily": "Segoe UI",
        "fontSize": 12,
        "bold": false,
        "italic": false,
        "underline": false
      }
    ],
    "categoryAxis": [
      {
        "position": "Left",
        "show": true,
        "axisType": "Scalar",
        "axisScale": "linear",
        "invertAxis": false,
        "labelColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "preferredCategoryWidth": 20,
        "maxMarginFactor": 25,
        "innerPadding": 20,
        "showAxisTitle": false,
        "titleColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "titleFontSize": 14,
        "titleFontFamily": "Segoe UI",
        "gridlineShow": true,
        "gridlineColor": {
          "solid": {
            "color": "#e3e2e1"
          }
        },
        "gridlineThickness": 1,
        "gridlineStyle": "solid"
      }
    ],
    "valueAxis": [
      {
        "position": "Left",
        "gridlineShow": true,
        "show": true,
        "invertAxis": false,
        "labelColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "switchAxisPosition": false,
        "labelDisplayUnits": 1,
        "labelPrecision": 0,
        "showAxisTitle": false,
        "axisStyle": "showTitleOnly",
        "titleColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "titleFontSize": 14,
        "titleFontFamily": "Segoe UI",
        "titleBold": false,
        "titleItalic": false,
        "titleUnderline": false,
        "gridlineColor": {
          "solid": {
            "color": "#e3e2e1"
          }
        },
        "gridlineThickness": 1,
        "gridlineStyle": "solid"
      }
    ],
    "labels": [
      {
        "color": {
          "solid": {
            "color": "#191815"
          }
        },
        "labelDisplayUnits": 1,
        "labelPrecision": 0,
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "show": true,
        "labelOrientation": 1,
        "labelPosition": "OutsideEnd",
        "enableBackground": false,
        "backgroundColor": {
          "solid": {
            "color": "#605E5C"
          }
        },
        "backgroundTransparency": 90
      }
    ],
    "plotArea": [
      {
        "image": {
          "name": "",
          "url": "",
          "scaling": "Normal"
        },
        "transparency": 20
      }
    ],
    "sentimentColors": [
      {
        "increaseFill": {
          "solid": {
            "color": "#295e47"
          }
        },
        "decreaseFill": {
          "solid": {
            "color": "#ed2135"
          }
        },
        "totalFill": {
          "solid": {
            "color": "#59a3d6"
          }
        },
        "otherFill": {
          "solid": {
            "color": "#191815"
          }
        }
      }
    ],
    "title": [
      {
        "show": true,
        "heading": "Normal",
        "titleWrap": true,
        "fontColor": {
          "solid": {
            "color": "#191815"
          }
        },
        "background": {
          "solid": {
            "color": "#FFFFFF00"
          }
        },
        "alignment": "left",
        "fontSize": 14,
        "fontFamily": "Segoe UI",
        "bold": true,
        "italic": false,
        "underline": false
      }
    ],
    "subTitle": [
      {
        "show": false,
        "heading": "Normal",
        "fontFamily": "Segoe UI",
        "fontSize": 10,
        "bold": false,
        "italic": false,
        "underline": false,
        "fontColor": {
          "solid": {
            "color": "#605e5c"
          }
        },
        "alignment": "left",
        "titleWrap": true
      }
    ],
    "divider": [
      {
        "show": false,
        "color": {
          "solid": {
            "color": "#605E5C"
          }
        },
        "style": "solid",
        "width": 1,
        "ignorePadding": true
      }
    ],
    "spacing": [
      {
        "customizeSpacing": false,
        "verticalSpacing": 5,
        "spaceBelowTitle": 5,
        "spaceBelowSubTitle": 5,
        "spaceBelowTitleArea": 5
      }
    ],
    "lockAspect": [
      {
        "show": false
      }
    ],
    "visualTooltip": [
      {
        "show": true,
        "type": "Default",
        "titleFontColor": {
          "solid": {
            "color": "#ffffff"
          }
        },
        "valueFontColor": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "actionFontColor": {
          "solid": {
            "color": "#f3f2f1"
          }
        },
        "fontSize": 12,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "background": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 5,
        "page": "Auto"
      }
    ],
    "visualHeader": [
      {
        "show": true,
        "background": {
          "solid": {
            "color": "#FFFFFF"
          }
        },
        "border": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 0,
        "foreground": {
          "solid": {
            "color": "#191815"
          }
        },
        "showVisualInformationButton": false,
        "showVisualWarningButton": false,
        "showVisualErrorButton": false,
        "showDrillRoleSelector": false,
        "showDrillUpButton": true,
        "showDrillToggleButton": true,
        "showDrillDownLevelButton": false,
        "showDrillDownExpandButton": true,
        "showPinButton": false,
        "showFocusModeButton": true,
        "showFilterRestatementButton": false,
        "showSeeDataLayoutToggleButton": false,
        "showOptionsMenu": false,
        "showTooltipButton": false,
        "showCommentButton": false,
        "showPersonalizeVisualButton": false,
        "showSmartNarrativeButton": false
      }
    ],
    "visualHeaderTooltip": [
      {
        "titleFontColor": {
          "solid": {
            "color": "#C8C8C8"
          }
        },
        "fontSize": 9,
        "fontFamily": "Segoe UI",
        "bold": false,
        "italic": false,
        "underline": false,
        "background": {
          "solid": {
            "color": "#191815"
          }
        },
        "transparency": 5
      }
    ]
  }
}
